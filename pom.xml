<?xml version="1.0" encoding="UTF-8" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.castles</groupId>
    <artifactId>student-documents</artifactId>
    <version>1.0-SNAPSHOT</version>


    <!--Родительский Spring Boot POM-->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.11</version>
        <relativePath/> <!-- Всегда ищем в репозитории, не в локальной файловой системе -->
    </parent>


    <properties>
        <java.version>21</java.version>


        <!-- Testcontainers 1.21.4:
        !!!Совместим с Docker Desktop 4.84 / Docker Engine 29+ (минимальный API 1.44)!!!
        -->
        <testcontainers.version>1.21.4</testcontainers.version>

        <!-- Версия Lombok для аннотационного процессора и зависимости -->
        <lombok.version>1.18.38</lombok.version>
        <!-- Версия JUnit 5 (Jupiter) – используется BOM'ом -->
        <junit.jupiter.version>5.11.4</junit.jupiter.version>
        <!-- Версия MapStruct (общая для API и процессора) -->
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <!-- Версия связки Lombok-MapStruct (избавляет от конфликтов) -->
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
    </properties>


    <dependencyManagement>
        <dependencies>
            <!-- BOM для JUnit 5: управляет версиями Jupiter, Vintage, Platform и т.д. -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.jupiter.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!--
                BOM для Testcontainers:
                - Управляет версиями всех модулей (core, junit-jupiter, postgresql и др.)
                - Версия задана свойством testcontainers.version (1.21.4)
            -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Основные стартеры Spring Boot-->
        <!-- Web-слой (REST, встроенный Tomcat, Jackson) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Доступ к данным через JPA (Hibernate + Spring Data) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Утилиты -->
        <!-- MapStruct для преобразования сущностей -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Lombok: сокращает шаблонный код (геттеры, сеттеры, конструкторы и т.д.) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!--
            Связка Lombok и MapStruct:
            - Гарантирует корректную совместную работу аннотационных процессоров
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok-mapstruct-binding</artifactId>
            <version>${lombok-mapstruct-binding.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- База данных -->
        <!-- Драйвер PostgreSQL (runtime – нужен только во время выполнения) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Инструментарий -->
        <!--
            Аннотационный процессор Spring Boot:
            - Генерирует метаданные для @ConfigurationProperties, улучшая автодополнение в IDE
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <scope>annotationProcessor</scope>
        </dependency>

        <!--
            Spring Boot Docker Compose:
            - Автоматически запускает описанные в docker-compose.yml сервисы при старте приложения
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-docker-compose</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            Транспорт docker-java (httpclient5).
            Помогает стабильнее работать с Docker Desktop на Windows.
        -->
        <dependency>
            <groupId>com.github.docker-java</groupId>
            <artifactId>docker-java-transport-httpclient5</artifactId>
            <version>3.4.2</version>
            <scope>test</scope>
        </dependency>

        <!--
            Логирование:
            - Logback – стандартная реализация SLF4J в Spring Boot
        -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.5.16</version>
        </dependency>

        <!-- Тестирование -->
        <!--
            Основной стартер для тестов Spring Boot:
            - Включает JUnit Jupiter (управляемый BOM'ом), Mockito, Hamcrest, Spring Test и т.д.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Testcontainers – ядро (версия управляется BOM'ом 1.21.4):
            - Предоставляет легковесные throwaway-контейнеры для интеграционных тестов
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Интеграция Testcontainers с JUnit Jupiter (расширения, аннотации) -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Модуль PostgreSQL для Testcontainers: автоматически поднимает контейнер с PostgreSQL -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            AssertJ:
            - Текучие (fluent) проверки (assertThat(...).isNotNull()...)
            - Улучшает читаемость тестов
        -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Библиотека для генерации реалистичных случайных значений -->
        <dependency>
            <groupId>net.datafaker</groupId>
            <artifactId>datafaker</artifactId>
            <version>2.7.0</version>
        </dependency>

        <!-- Flyway для управлением структурой БД -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!--
                Spring Boot Maven Plugin:
                - Позволяет создавать исполняемый JAR, запускать приложение через mvn spring-boot:run
                - Обрабатывает re-packaging и др.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
                Компилятор Maven:
                - Явно задаём версию плагина для воспроизводимости
                - Указываем версии исходного и целевого кода Java
                - Настраиваем annotationProcessorPaths, чтобы процессоры Lombok и MapStruct работали вместе
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <annotationProcessorPaths>
                        <!-- Lombok аннотационный процессор -->
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <!-- Связка Lombok и MapStruct -->
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok-mapstruct-binding.version}</version>
                        </path>
                        <!-- MapStruct процессор: генерирует реализации мапперов -->
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <!--
                        Дополнительные аргументы компилятора:
                        - Указываем MapStruct использовать Spring как компонентную модель (мапперы становятся @Component)
                    -->
                    <compilerArgs>
                        <arg>-Amapstruct.defaultComponentModel=spring</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!--
                Maven Surefire Plugin для запуска тестов.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <!-- без systemPropertyVariables с docker.client.strategy -->
            </plugin>
        </plugins>
    </build>
</project>